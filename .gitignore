# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
uv.lock

# Virtual environments
.venv
settings*json

# Intermediate documents and tests
*.md
!README.md
!AGENTS.md
!notes/*.md
/notes/archive/*.md
test*

# Large files
checkpoints/

.gemini
.github
.inspire
gha-creds-*.json
.factory
.agent

package-lock.json

# Tests
!tests/
!tests/*.py

# Checkpoints and sample images
checkpoint*
output/*/*.png
wandb
swanlog

# Local corpora and results, at the repository root only.  Without the leading
# slash these also swallow scripts/data, which holds the harvesters and
# publishers and does belong in the repository.
/data/
/precomputed_dataset/
/output/
/literature/
# Cloned reference implementations (DMD2, DMDR, DiffusionNFT, ...), read-only
# study material; licenses differ from this repository, so never vendored.
/refs/
/scored_images/
/bucket_plans/*
!/bucket_plans/ascend/
/bucket_plans/ascend/*
!/bucket_plans/ascend/hero-*-k20.json
!/bucket_plans/ascend/*.report.md

# Local cluster job wrappers and exploratory analysis are retained on disk,
# not shipped as supported launch tooling. Repeatable launchers live in scripts/.
/jobs/*
/scripts/bench/boundary_waste_analysis.py
/scripts/bench/check_calib_896p.py
/scripts/bench/inspect_calib.py
/scripts/bench/pull_val_metrics.py
/scripts/data/merge_precompute_parts.py

# Credentials and machine-local operational state must never be published.
.env
.env.*
!.env.example
*.netrc
.netrc
*.pem
*.key
/INSPIRE.md
