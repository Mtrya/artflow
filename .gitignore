# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
uv.lock

# Virtual environments
.venv
settings*json

# Intermediate documents and tests
*.md
!README.md
!AGENTS.md
!notes/*.md
!SKILL.md
!/.agents/rule-examples.md
/notes/archive/*.md
test*

# Large files
checkpoints/

.gemini
.github
.inspire
gha-creds-*.json
.factory
.agent

package-lock.json

# Tests
!tests/
!tests/*.py

# Checkpoints and sample images
checkpoint*
output/*/*.png
wandb
swanlog

# Local corpora and results, at the repository root only.  Without the leading
# slash these also swallow scripts/data, which holds the harvesters and
# publishers and does belong in the repository.
/data/
/precomputed_dataset/
/output/
/literature/
# Cloned reference implementations (DMD2, DMDR, DiffusionNFT, ...), read-only
# study material; licenses differ from this repository, so never vendored.
/refs/
/scored_images/
/models/
/runs/

# Scratch space for local job wrappers and exploratory probes. One-off code is
# deleted once its evidence is extracted into notes; repeatable launchers and
# tools are promoted into scripts/. Nothing here is supported or shipped.
/jobs/*

# Credentials and machine-local operational state must never be published.
.env
.env.*
!.env.example
*.netrc
.netrc
*.pem
*.key
/INSPIRE.md
