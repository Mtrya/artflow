# Frozen hero inputs; render with scripts.bench.render_hero_stage.
# Layer after base.toml and before hero.toml and global-T launch overrides.
[data]
mix = "${ARTFLOW_ROOT}/precomputed_dataset/d1@640p:10.820000 ${ARTFLOW_ROOT}/precomputed_dataset/d2-wikiart@640p:12.320000 ${ARTFLOW_ROOT}/precomputed_dataset/d2-museum@640p:0.780000 ${ARTFLOW_ROOT}/precomputed_dataset/d3-human@640p:12.190000 ${ARTFLOW_ROOT}/precomputed_dataset/d3-people-a@640p:5.876955 ${ARTFLOW_ROOT}/precomputed_dataset/d3-people-b@640p:5.883045 ${ARTFLOW_ROOT}/precomputed_dataset/d3-pexels@640p:6.660000 ${ARTFLOW_ROOT}/precomputed_dataset/d3-synth-v2@640p:0.780000 ${ARTFLOW_ROOT}/precomputed_dataset/d4-megalith@640p:0.380000 ${ARTFLOW_ROOT}/precomputed_dataset/d4-pd12m@640p:8.430000 ${ARTFLOW_ROOT}/precomputed_dataset/d4-vintage@640p:9.410000 ${ARTFLOW_ROOT}/precomputed_dataset/d4-zimage@640p:3.220000 ${ARTFLOW_ROOT}/precomputed_dataset/d4-relaion-p0@640p:4.649294 ${ARTFLOW_ROOT}/precomputed_dataset/d4-relaion-p1@640p:4.634332 ${ARTFLOW_ROOT}/precomputed_dataset/d4-relaion-p2@640p:4.651669 ${ARTFLOW_ROOT}/precomputed_dataset/d4-relaion-p3@640p:4.650601 ${ARTFLOW_ROOT}/precomputed_dataset/d4-relaion-p4@640p:4.654104"
bucket_plan = "${ARTFLOW_ROOT}/bucket_plans/hero/batch-targets-0914/hero-640p-k20.json"
[text_encoder]
path = "${ARTFLOW_ROOT}/models/Qwen3-0.6B"
[eval]
dataset_path = "${ARTFLOW_ROOT}/precomputed_dataset/light-eval@640p"
[paths]
vae = "${ARTFLOW_ROOT}/models/e2e-qwenimage-vae"
output_dir = "${ARTFLOW_ROOT}/runs"
