# Frozen hero inputs; render with scripts.bench.render_hero_stage.
# Layer after base.toml and before hero.toml and global-T launch overrides.
[data]
mix = "${ARTFLOW_ROOT}/precomputed_dataset/d1@256p:8.177400 ${ARTFLOW_ROOT}/precomputed_dataset/d2-wikiart@256p:11.487900 ${ARTFLOW_ROOT}/precomputed_dataset/d2-museum@256p:0.540200 ${ARTFLOW_ROOT}/precomputed_dataset/d3-human@256p:9.531500 ${ARTFLOW_ROOT}/precomputed_dataset/d3-people@256p:9.205600 ${ARTFLOW_ROOT}/precomputed_dataset/d3-pexels@256p:5.020600 ${ARTFLOW_ROOT}/precomputed_dataset/d3-synth-v2@256p:0.584640 ${ARTFLOW_ROOT}/precomputed_dataset/d4-inat@256p:0.151520 ${ARTFLOW_ROOT}/precomputed_dataset/d4-megalith@256p:0.344630 ${ARTFLOW_ROOT}/precomputed_dataset/d4-pd12m@256p:8.711300 ${ARTFLOW_ROOT}/precomputed_dataset/d4-vintage@256p:10.445800 ${ARTFLOW_ROOT}/precomputed_dataset/d4-zimage@256p:2.427500 ${ARTFLOW_ROOT}/precomputed_dataset/d4-relaion@256p:33.371500"
bucket_plan = "${ARTFLOW_ROOT}/bucket_plans/hero/batch-targets-0914/hero-256p-k20.json"
[text_encoder]
path = "${ARTFLOW_ROOT}/models/Qwen3-0.6B"
[eval]
dataset_path = "${ARTFLOW_ROOT}/precomputed_dataset/light-eval@256p"
[paths]
vae = "${ARTFLOW_ROOT}/models/e2e-qwenimage-vae"
output_dir = "${ARTFLOW_ROOT}/runs"
